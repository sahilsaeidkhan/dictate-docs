+"""Exponential backoff retries for the API client."""
+import random
+import time
+
+
+def with_retry(fn, attempts=3, base_delay=1.0, jitter=True):
+    """Run fn, retrying with exponential backoff on failure."""
+    last_exc = None
+    for i in range(attempts):
+        try:
+            return fn()
+        except Exception as exc:  # noqa: BLE001
+            last_exc = exc
+            delay = base_delay * (2 ** i)
+            if jitter:
+                delay *= random.uniform(0.5, 1.5)
+            time.sleep(delay)
+    raise last_exc
+
+
+class RetryConfig:
+    def __init__(self, attempts=3, base_delay=1.0, jitter=True):
+        self.attempts = attempts
+        self.base_delay = base_delay
+        self.jitter = jitter
