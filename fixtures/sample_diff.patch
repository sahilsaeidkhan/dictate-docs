+++ b/tests/test_retry.py
@@ -0,0 +1,18 @@
+import pytest
+from dictate_docs.retry import with_retry
+
+
+def test_retry_succeeds_after_failures():
+    calls = []
+
+    def flaky():
+        calls.append(1)
+        if len(calls) < 3:
+            raise ConnectionError("boom")
+        return "ok"
+
+    assert with_retry(flaky, attempts=3, base_delay=0) == "ok"
+
+
+def test_retry_raises_after_attempts():
+    with pytest.raises(ConnectionError):
+        with_retry(lambda: (_ for _ in ()).throw(ConnectionError()),
+                   attempts=2, base_delay=0)
